<Window x:Class="SptLinuxInstaller.App.Dialogs.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" SizeToContent="Height"
        Width="620" MaxWidth="620" MinHeight="150"
        Background="#11171C" Foreground="#EDF3F5"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DialogFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="#EDF3F5" BorderThickness="2"
                                CornerRadius="9" Margin="-4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogAction" TargetType="Button">
            <Setter Property="Background" Value="#2B3A43"/>
            <Setter Property="Foreground" Value="#EDF3F5"/>
            <Setter Property="BorderBrush" Value="#48606D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#EDF3F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogDefaultAction" TargetType="Button" BasedOn="{StaticResource DialogAction}">
            <Setter Property="Background" Value="#7BD6B5"/>
            <Setter Property="Foreground" Value="#10251D"/>
            <Setter Property="BorderBrush" Value="#7BD6B5"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33434D" BorderThickness="1" Background="#11171C">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#1A242B" BorderBrush="#33434D" BorderThickness="0,0,0,1"
                    Padding="20,12,12,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DialogTitle" FontWeight="SemiBold" FontSize="15"
                               Margin="0,0,14,0" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="CloseButton" Grid.Column="1" Content="&#x00D7;"
                            Style="{StaticResource DialogAction}" Width="34" Height="32"
                            MinWidth="34" MinHeight="32" Padding="0" FontSize="22"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="Schließen (Esc)" AutomationProperties.Name="Dialog schließen"
                            KeyboardNavigation.TabIndex="4" Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,24,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconPanel" Width="36" Height="36" CornerRadius="18"
                        Background="#243B36" Margin="0,1,16,0" VerticalAlignment="Top">
                    <TextBlock x:Name="IconText" Text="i" FontWeight="SemiBold" FontSize="23"
                               Foreground="#7BD6B5" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Focusable="False"/>
                </Border>
                <ScrollViewer x:Name="MessageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                              Focusable="False">
                    <TextBox x:Name="MessageText" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent"
                             Foreground="#EDF3F5" BorderThickness="0" Padding="0" MinHeight="0"
                             SelectionBrush="#427B69" FontSize="14" Cursor="IBeam"
                             VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Disabled" KeyboardNavigation.TabIndex="3"
                             AutomationProperties.Name="Dialogtext"
                             AutomationProperties.HelpText="Der Text kann markiert und kopiert werden."/>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Background="#1A242B" BorderBrush="#33434D"
                    BorderThickness="0,1,0,0" Padding="24,16">
                <StackPanel x:Name="ActionPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="AcceptButton" Style="{StaticResource DialogAction}"
                            KeyboardNavigation.TabIndex="1" Click="Action_Click"/>
                    <Button x:Name="RejectButton" Style="{StaticResource DialogAction}" Margin="12,0,0,0"
                            KeyboardNavigation.TabIndex="2" Click="Action_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
